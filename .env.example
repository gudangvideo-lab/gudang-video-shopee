# =============================================================================
# CONTOH VARIABEL LINGKUNGAN (.env.example)
# PENTING: File ini HANYA merupakan template dokumentasi.
# JANGAN PERNAH memasukkan secret, password, atau API key sungguhan di sini.
# =============================================================================

# [Frontend] URL dasar untuk pemanggilan API di Vite (default: /api)
VITE_API_BASE_URL=/api

# [Worker / Backend] Lingkungan runtime lokal
ENVIRONMENT=development

# Catatan untuk Backend Cloudflare Worker:
# Untuk secret lokal Cloudflare Worker, gunakan file terpisah bernama `.dev.vars`.
# File `.dev.vars` otomatis diabaikan oleh Git (.gitignore) dan tidak boleh di-commit.
